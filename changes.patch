+		ms_total = (double)(_perfEnd_total.QuadPart - _perfStart_total.QuadPart) * 1000.0 / _perfFreq_step.QuadPart;
+		
+		// Only log if above threshold (15ms)
+		if(ms_total > PERF_LOG_THRESHOLD_MS) {
+			char debugTag[256];
+			sprintf_s(debugTag, "APP_SWITCH[%s] Total=%.2fms GetApp=%.2fms", 
+				appName, ms_total, ms_getAppName);
+			PerformanceLogger::log(debugTag, ms_total);
+		}
+	}
 }
